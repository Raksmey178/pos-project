// Prisma 7: the database URL lives in prisma.config.ts, not here.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Phase 0 starts with one real table so migrations and the client have
// something to work with. More tables arrive phase by phase.
// Percentages are stored in basis points: 1000 = 10%.
model Setting {
  id                  Int      @id @default(1)
  restaurantName      String
  vatBps              Int      @default(0)
  serviceChargeBps    Int      @default(0)
  discountApprovalBps Int      @default(1000)
  updatedAt           DateTime @updatedAt
}

// ---------- Phase 2: staff, login sessions, audit log ----------

enum Role {
  WAITER
  CASHIER
  KITCHEN
  MANAGER
  ADMIN
}

// Staff are never deleted (the audit log points at them). They are deactivated.
model Staff {
  id                String      @id @default(uuid())
  name              String      @unique
  role              Role
  pinHash           String // Argon2 hash. The PIN itself is never stored.
  isActive          Boolean     @default(true)
  failedPinAttempts Int         @default(0)
  lockedUntil       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  sessions          Session[]
  auditLogs         AuditLog[]
  ordersOpened      Order[]     @relation("OrderOpenedBy")
  itemsAdded        OrderItem[] @relation("OrderItemAddedBy")
  itemsRemoved      OrderItem[] @relation("OrderItemRemovedBy")
}

// One row per login. The browser holds a random token; we store only its hash,
// so a database leak does not hand out usable logins.
model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  staffId   String
  staff     Staff     @relation(fields: [staffId], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([staffId])
}

// Append-only: a database trigger blocks UPDATE, DELETE and TRUNCATE
// (see prisma/sql/audit-log-append-only.sql).
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  actorId    String? // null = nobody was logged in (e.g. a failed login)
  actor      Staff?   @relation(fields: [actorId], references: [id])
  action     String // e.g. "auth.login", "staff.create"
  entityType String?
  entityId   String?
  details    Json? // small facts only. NEVER PINs, hashes or tokens.

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ---------- Phase 3: menu ----------
// Nothing in the menu is ever deleted: it is switched off (isActive = false).
// Old orders will keep their own copy of names and prices (Phase 5), so changing
// the menu never changes past sales.

// Where an item is prepared: Kitchen, Bar, ... Each station gets its own kitchen tickets (Phase 6).
model Station {
  id         String      @id @default(uuid())
  name       String      @unique
  sortOrder  Int         @default(0)
  isActive   Boolean     @default(true)
  items      MenuItem[]
  orderItems OrderItem[]
}

model Category {
  id        String     @id @default(uuid())
  nameKm    String     @unique
  nameEn    String? // optional, for when English is added
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
}

model MenuItem {
  id             String                  @id @default(uuid())
  categoryId     String
  category       Category                @relation(fields: [categoryId], references: [id])
  stationId      String
  station        Station                 @relation(fields: [stationId], references: [id])
  nameKm         String
  nameEn         String?
  priceCents     Int // USD cents: 350 = $3.50
  isSoldOut      Boolean                 @default(false)
  isActive       Boolean                 @default(true)
  sortOrder      Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]

  @@unique([categoryId, nameKm])
  @@index([categoryId])
  @@index([stationId])
}

// A question asked when ordering: "Size?", "Sugar level?", "Extras?".
// minSelect/maxSelect: Size = 1..1 (must pick one), Extras = 0..3 (pick up to three).
model ModifierGroup {
  id        String                  @id @default(uuid())
  nameKm    String                  @unique
  nameEn    String?
  minSelect Int                     @default(0)
  maxSelect Int                     @default(1)
  sortOrder Int                     @default(0)
  isActive  Boolean                 @default(true)
  options   ModifierOption[]
  items     MenuItemModifierGroup[]
}

// One answer: "Large" (+$1.00), "No sugar" ($0.00), "Extra egg" (+$0.50).
model ModifierOption {
  id              String              @id @default(uuid())
  groupId         String
  group           ModifierGroup       @relation(fields: [groupId], references: [id])
  nameKm          String
  nameEn          String?
  priceDeltaCents Int                 @default(0) // may be negative
  sortOrder       Int                 @default(0)
  isActive        Boolean             @default(true)
  orderModifiers  OrderItemModifier[]

  @@unique([groupId, nameKm])
  @@index([groupId])
}

// Which questions are asked for which item.
model MenuItemModifierGroup {
  menuItemId      String
  modifierGroupId String
  sortOrder       Int           @default(0)
  menuItem        MenuItem      @relation(fields: [menuItemId], references: [id])
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  @@id([menuItemId, modifierGroupId])
  @@index([modifierGroupId])
}

// ---------- Phase 4: tables and floor plan ----------
// The floor plan is a grid of 24 columns x 16 rows per zone. A table sits on whole
// grid cells (gridX, gridY, width, height). Tables are never deleted, only switched off.
// A table's status (available / occupied / bill requested) is NOT stored: from Phase 5
// it is worked out from the table's open order, so it can never get out of sync.

enum TableShape {
  RECT
  ROUND
}

// An area of the restaurant with its own floor plan: "Indoor", "Terrace", "Upstairs".
model Zone {
  id        String        @id @default(uuid())
  name      String        @unique
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  tables    DiningTable[]
}

model DiningTable {
  id          String       @id @default(uuid())
  zoneId      String
  zone        Zone         @relation(fields: [zoneId], references: [id])
  name        String       @unique
  capacity    Int          @default(4)
  shape       TableShape   @default(RECT)
  gridX       Int          @default(0)
  gridY       Int          @default(0)
  width       Int          @default(2)
  height      Int          @default(2)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  orderTables OrderTable[]

  @@index([zoneId])
}

// ---------- Phase 5: orders ----------
// What was ordered is COPIED into the order (name, price, options), so changing the menu
// later never changes an old order or a past sale. Nothing here is deleted: a removed
// item is marked removedAt, a cancelled order becomes VOIDED.

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  BILL_REQUESTED
  PAID // Phase 8
  VOIDED
  MERGED // its items and tables moved into another order
}

enum OrderItemStatus {
  NEW
  PREPARING // Phase 6
  READY
  SERVED
}

// Gap-free numbers: one row per counter (for orders: one per business day).
model Counter {
  key   String @id
  value Int    @default(0)
}

model Order {
  id              String       @id @default(uuid())
  clientOrderId   String       @unique // made by the device; a retry never creates a second order
  businessDate    String // "2026-11-05" in the restaurant's time zone
  orderNumber     Int // 1, 2, 3 ... restarts every business day
  type            OrderType
  status          OrderStatus  @default(OPEN)
  guestCount      Int?
  customerName    String? // takeaway / delivery
  customerPhone   String?
  deliveryAddress String?
  openedById      String
  openedBy        Staff        @relation("OrderOpenedBy", fields: [openedById], references: [id])
  mergedIntoId    String?
  mergedInto      Order?       @relation("OrderMerge", fields: [mergedIntoId], references: [id])
  mergedFrom      Order[]      @relation("OrderMerge")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tables          OrderTable[]
  items           OrderItem[]

  @@unique([businessDate, orderNumber])
  @@index([status])
}

// Which tables an order occupies. releasedAt = null means "still occupying".
// A database rule allows only ONE such row per table (prisma/sql/one-active-order-per-table.sql).
model OrderTable {
  id         String      @id @default(uuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id])
  tableId    String
  table      DiningTable @relation(fields: [tableId], references: [id])
  createdAt  DateTime    @default(now())
  releasedAt DateTime?

  @@index([orderId])
  @@index([tableId])
}

model OrderItem {
  id             String              @id @default(uuid())
  clientItemId   String              @unique // made by the device; a retry never adds the item twice
  orderId        String
  order          Order               @relation(fields: [orderId], references: [id])
  menuItemId     String
  menuItem       MenuItem            @relation(fields: [menuItemId], references: [id])
  nameKm         String // copy of the menu name at the time of ordering
  nameEn         String?
  unitPriceCents Int // copy of the menu price at the time of ordering
  quantity       Int
  note           String?
  status         OrderItemStatus     @default(NEW)
  stationId      String // where it is prepared (copy), for kitchen tickets in Phase 6
  station        Station             @relation(fields: [stationId], references: [id])
  addedById      String
  addedBy        Staff               @relation("OrderItemAddedBy", fields: [addedById], references: [id])
  createdAt      DateTime            @default(now())
  removedAt      DateTime?
  removedById    String?
  removedBy      Staff?              @relation("OrderItemRemovedBy", fields: [removedById], references: [id])
  modifiers      OrderItemModifier[]

  @@index([orderId])
}

model OrderItemModifier {
  id               String         @id @default(uuid())
  orderItemId      String
  orderItem        OrderItem      @relation(fields: [orderItemId], references: [id])
  modifierOptionId String
  modifierOption   ModifierOption @relation(fields: [modifierOptionId], references: [id])
  groupNameKm      String // copies, as above
  nameKm           String
  priceDeltaCents  Int

  @@index([orderItemId])
}
