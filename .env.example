# Copy this file to ".env" and change the values. Never commit ".env".
# If a password has special characters (@ : / # ?), URL-encode it in DATABASE_URL.

# --- Database (POSTGRES_* are only used by docker-compose) ---
POSTGRES_USER=pos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pos
DATABASE_URL=postgresql://pos:change-me@localhost:5432/pos

# --- Security ---
# Secret key mixed into every PIN hash (at least 32 characters). Make your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it private and never change it afterwards, or every PIN stops working.
PIN_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# --- First Admin (used once by: npm run staff:create-admin) ---
# After the first login, change the PIN inside the app and delete INITIAL_ADMIN_PIN from this file.
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_PIN=
